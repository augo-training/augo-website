# Copy to .env for local development. All values are optional locally;
# tracking and email capture silently no-op when unset.

# Mixpanel EU project token for the website ("archived_website" project).
# In CI this comes from the GitHub repo secret named MIXPANEL (see deploy.yml).
VITE_MIXPANEL_TOKEN=
# In `vite dev` nothing is sent to Mixpanel unless this is 1, so local work
# does not pollute the production project. Production builds ignore it.
VITE_MIXPANEL_DEBUG=

VITE_SIGNUP_WEBHOOK_URL=
VITE_MAILERLITE_GROUP_ID=
VITE_MAILERLITE_HUMANEDGE_GROUP_ID=
# Optional overrides. The Nice landing pages have these ids hardcoded, so they
# work without these being set.
VITE_MAILERLITE_NICE_ATHLETES_GROUP_ID=
VITE_MAILERLITE_NICE_COACHES_GROUP_ID=
